# Copy to .env and fill in. .env is gitignored — it holds a key-encryption
# password and an RPC endpoint that may carry credentials.

# Bee image, must match fleet.yml's bee_image intent. Verify against the current
# mainnet release before deploying.
BEE_IMAGE=ethersphere/bee:2.8.1

# Public IP of this host. Used for BEE_NAT_ADDR so nodes advertise a reachable
# P2P address; without it, eight nodes behind one host get poor inbound
# connectivity and your peer-count measurements reflect that, not the network.
PUBLIC_IP=

# Gnosis Chain RPC endpoint. Required — bee will not start without it.
# Eight nodes on one endpoint generates real request volume; a public endpoint
# will likely rate-limit you. Prefer your own node or a paid provider.
GNOSIS_RPC_ENDPOINT=

# Password encrypting each node's keystore.
#
# BACK THIS UP. Every node's wallet key is encrypted with it, so losing it means
# losing access to the funds in all of them, volumes intact or not.
BEE_PASSWORD=

# Grafana admin password. Grafana is bound to loopback; reach it over an SSH
# tunnel:  ssh -L 3000:localhost:3000 <host>
GRAFANA_ADMIN_PASSWORD=
