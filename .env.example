# Copy to .env and fill in. .env is gitignored — it holds a key-encryption
# password and an RPC endpoint that may carry credentials.

# Log level override for all bee nodes. fleet.yml defaults to `warn`, which keeps
# log write traffic off the disk the reserve lives on — but it also suppresses
# logger.Info lines: chequebook deployment, sync progress, the funding URL. Set
# this to `info` while diagnosing a node, then put it back.
#   BEE_VERBOSITY=info && make up-bees
BEE_VERBOSITY=

# Bee image, must match fleet.yml's bee_image intent. Verify against the current
# mainnet release before deploying.
BEE_IMAGE=ethersphere/bee:2.8.1

# Public IP of this host. Used for BEE_NAT_ADDR so nodes advertise a reachable
# P2P address; without it, eight nodes behind one host get poor inbound
# connectivity and your peer-count measurements reflect that, not the network.
PUBLIC_IP=

# Gnosis Chain RPC endpoint. Required — bee will not start without it.
# Eight nodes on one endpoint generates real request volume; a public endpoint
# will likely rate-limit you. Prefer your own node or a paid provider.
GNOSIS_RPC_ENDPOINT=

# Password encrypting each node's keystore.
#
# BACK THIS UP. Every node's wallet key is encrypted with it, so losing it means
# losing access to the funds in all of them, volumes intact or not.
BEE_PASSWORD=

# Grafana admin password. Use something long and random:  openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Where Grafana listens on the host.
#
# 127.0.0.1 (default) = loopback only, reach it with an SSH tunnel:
#   ssh -L 3000:localhost:3000 <host>
#
# 0.0.0.0 = reachable from the internet. Grafana has its own login, so this is
# defensible — but over plain HTTP the password crosses the network in cleartext.
# Prefer putting it behind TLS (see DEPLOY.md) or restrict the source with
# GRAFANA_ALLOW_CIDR below. After changing this, run: make firewall-grafana
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Who may reach the Grafana port. Comma-separated; each entry is a single IP
# (203.0.113.4 or 203.0.113.4/32) or a range (203.0.113.0/24 = 256 addresses).
#
# Enforced through iptables' DOCKER-USER chain by `make firewall-grafana`, NOT
# through ufw. Docker publishes ports via its own FORWARD-chain rules, which ufw
# never sees — so a ufw rule (or even ufw's default-deny) does not restrict a
# published container port at all. Check with `make firewall-status`.
#   GRAFANA_ALLOW_CIDR=203.0.113.4,198.51.100.7,192.0.2.0/24
# Leave empty to allow any source — only sensible behind TLS.
# NOTE: iptables rules are not reboot-persistent; re-run firewall-grafana after one.
GRAFANA_ALLOW_CIDR=

# Set when serving Grafana over a hostname/TLS, e.g. https://hawtch.example.org
# Setting an https:// URL also enables secure cookies and HSTS.
GRAFANA_ROOT_URL=
GRAFANA_COOKIE_SECURE=false

# Prometheus is NOT exposable by design — it has no authentication at all.
# Anyone who can reach it can read every metric. Use Grafana, or a tunnel.

# ---- sidecar probes ---------------------------------------------------------

# Feed owner key for the beefeeder probe (32-byte hex, no 0x prefix).
# Generate one:  openssl rand -hex 32
#
# MUST be stable across restarts. A new key is a new feed, so the reader would
# poll an address nobody is writing to and every run would time out.
FEED_PRIVATE_KEY=

# Postage. The probes cannot upload without a usable batch.
#
# Preferred: buy a batch yourself and pin it here, one per probe. Then a probe
# restart can never spend anything.
POSTAGE_BATCH_ID_LATENCY=
POSTAGE_BATCH_ID_BEEFEEDER=

# Sizing, if the probes buy their own: POSTAGE_SIZE_MB maps to a batch depth and
# depth is what costs xBZZ. 10 MB -> depth 19 (~2.0 xBZZ for 30d at the price
# seen in Aug 2026); 1 GB -> depth 21 (~7.9 xBZZ). Probe batches are mutable, so
# they recycle slots instead of filling up — small is correct here.
#
# Alternative: let the probes buy their own. Off by default on purpose — with
# auto-buy on, a crash-looping probe purchases a fresh batch on every restart,
# which is real xBZZ each time. The probe logs the estimated cost before buying,
# and prefers reusing an existing usable batch over purchasing.
POSTAGE_AUTO_BUY=false
