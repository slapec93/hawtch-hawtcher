{
  "uid": "hawtch-probes",
  "title": "Hawtch \u00b7 Active probes",
  "tags": [
    "hawtch"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Time since last success",
      "description": "A probe can be up and failing every run, so this \u2014 not `up` \u2014 is the health signal. Clamped at 0 because the probe stamps the timestamp from its own clock. 'never succeeded' means the probe is running (or was) but has not completed a single successful run; a genuinely absent probe shows no failure count either.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(time() - hawtch_probe_last_success_timestamp_seconds, 0)",
          "legendFormat": "{{probe}} age",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (probe) (hawtch_probe_runs_total{result=\"failure\"})",
          "legendFormat": "{{probe}} failures",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 900
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "noValue": "never succeeded"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failures"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "0"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Round-trip latency (p50 / p95)",
      "description": "Upload start to verified download, including retrieval retries.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, probe) (rate(hawtch_latency_roundtrip_duration_seconds_bucket[30m])))",
          "legendFormat": "{{probe}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, probe) (rate(hawtch_latency_roundtrip_duration_seconds_bucket[30m])))",
          "legendFormat": "{{probe}} p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Feed propagation (p50 / p95)",
      "description": "Write completion to the new update being readable at the paired node. Excludes the write itself.",
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, probe) (rate(hawtch_feed_propagation_duration_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, probe) (rate(hawtch_feed_propagation_duration_seconds_bucket[30m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (le, probe) (rate(hawtch_feed_write_duration_seconds_bucket[30m])))",
          "legendFormat": "write p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Failures by stage",
      "description": "Which part broke: upload, download, verify, feed-write, feed-propagation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hawtch_probe_stage_failures_total[30m]) * 3600",
          "legendFormat": "{{probe}} \u00b7 {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Retrieval effort \u2014 download attempts & stale feed reads",
      "description": "Rising attempts mean retrieval is degrading even when final latency still looks fine. Stale reads are valid reads of an older feed update \u2014 the reader is behind, not broken.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, probe) (rate(hawtch_latency_download_attempts_bucket[30m])))",
          "legendFormat": "download attempts p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, probe) (rate(hawtch_feed_poll_attempts_bucket[30m])))",
          "legendFormat": "feed poll attempts p95"
        },
        {
          "refId": "C",
          "expr": "rate(hawtch_feed_stale_reads_total[30m]) * 3600",
          "legendFormat": "stale feed reads/h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput (last run)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hawtch_latency_bytes_per_second",
          "legendFormat": "{{probe}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Postage health \u2014 the probes stop working without it",
      "description": "A filled or expired batch produces upload failures that look exactly like network failures.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hawtch-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * hawtch_probe_postage_batch_utilization",
          "legendFormat": "{{probe}} utilization %"
        },
        {
          "refId": "B",
          "expr": "hawtch_probe_postage_batch_ttl_seconds / 86400",
          "legendFormat": "{{probe}} TTL days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*TTL days"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "d"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*utilization %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      }
    }
  ]
}